{
  "name": "@blueberry/local-web",
  "version": "0.1.0",
  "private": true,
  "description": "Importable local browser host primitives with no runtime dependencies",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "os": ["win32", "darwin", "linux"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "IMPORTING.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
