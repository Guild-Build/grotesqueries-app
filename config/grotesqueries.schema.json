{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grotesqueries operator configuration v1",
  "type": "object",
  "properties": {
    "fleet": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "description": "Presence enables each role; omit fleet for standalone. Private-key paths are local, never public bootstrap fields. Role changes require restart.",
      "properties": {
        "coordinator": {
          "type": "object", "additionalProperties": false,
          "required": ["port", "workerPort", "workers"],
          "properties": {
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "workerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "workerBind": {"type": "string", "default": "127.0.0.1"},
            "stateFile": {"type": "string", "default": ".runtime/fleet.sqlite"},
            "developmentAccept": {"type": "boolean", "default": false},
            "certificateFile": {"type": "string"}, "privateKeyFile": {"type": "string"},
            "workers": {"type": "array", "maxItems": 32, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "label"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
                "label": {"type": "string", "minLength": 1, "maxLength": 256},
                "publicKeyFile": {"type": "string"},
                "actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["observe", "start", "control", "stop", "settings"]}}
              }
            }}
          }
        },
        "worker": {
          "type": "object", "additionalProperties": false, "required": ["id", "coordinatorURL"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "coordinatorURL": {"type": "string"}, "developmentAccept": {"type": "boolean", "default": false},
            "privateKeyFile": {"type": "string"}, "caFile": {"type": "string"}
          }
        }
      }
    },
    "version": {
      "const": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8765
    },
    "allowedProjectDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Local project directory, absolute or relative to the application folder on any local drive. Drive roots and network shares are excluded.",
        "maxLength": 4096
      }
    },
    "launchProfiles": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Direct executable on PATH, an absolute local executable, or an application-relative file path. Script shims require an explicit interpreter.",
            "maxLength": 4096
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 30000
            }
          },
          "projectDirectory": {
            "type": "string",
            "minLength": 1,
            "description": "Project directory resolved relative to the application folder and contained by an allowed project directory.",
            "maxLength": 4096
          },
          "environment": {
            "type": "object",
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "columns": {
            "type": "integer",
            "minimum": 20,
            "maximum": 300,
            "description": "Pinned terminal columns. Omit for automatic controller-pane sizing."
          }
        },
        "required": [
          "id",
          "label",
          "executable",
          "args",
          "projectDirectory"
        ],
        "additionalProperties": false
      }
    },
    "terminal": {
      "type": "object",
      "properties": {
        "scrollbackLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "recentOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "maxIncompleteSequenceBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 65536
        }
      },
      "required": [
        "scrollbackLines",
        "recentOutputBytes"
      ],
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "maxRunningSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 8
        },
        "retainedExitedSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 8
        },
        "maxViews": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64,
          "default": 16
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 60000,
          "default": 10000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "frame": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "The frame's built folder, served at /. Absolute or relative to this file's folder; resolved as a plugin's declared folder is. A junction, a link, a missing folder or a name that starts with a dot is refused at start. Absent: / answers 404."
    },
    "jobs": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 86400000,
          "default": 600000
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 268435456,
          "default": 8388608
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "maxFrameBytes": {
          "type": "integer",
          "minimum": 131072,
          "maximum": 1048576,
          "default": 262144
        },
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536,
          "default": 65536
        },
        "maxViewQueueBytes": {
          "type": "integer",
          "minimum": 262144,
          "maximum": 8388608,
          "default": 1048576
        },
        "maxRendererBacklogBytes": {
          "type": "integer",
          "minimum": 262144,
          "maximum": 8388608,
          "default": 1048576
        },
        "maxSnapshotBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 67108864,
          "default": 33554432
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "directory",
        "maxFiles",
        "maxFileBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "allowedProjectDirectories",
    "launchProfiles",
    "terminal",
    "diagnostics"
  ],
  "additionalProperties": false
}
